# Docker ignore file for BLNCS
# Reduces build context and improves build performance

# Git and version control
.git
.gitignore
.gitattributes

# Documentation
*.md
docs/
!README.md

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# Environment files (but keep .env.sample)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next

# Nuxt.js build output
.nuxt

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Data directories (development/testing data)
data/
backups/
dumps/

# Configuration files with sensitive data
config/local.yaml
config/production.yaml
config/secrets.yaml

# SSL certificates and keys
certs/
*.pem
*.key
*.crt
*.csr

# Kubernetes and deployment files
kubernetes/
helm/
terraform/
monitoring/

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
circle.yml

# Docker files (except main ones)
docker-compose.override.yml
docker-compose.local.yml

# Scripts for local development
scripts/dev/
scripts/local/

# Database files
*.db
*.sqlite
*.sqlite3

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Mypy cache
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# profiling data
profile.stats
*.prof

# pytest benchmarks
.benchmarks/

# Pylint configuration
.pylintrc

# Local development override files
override/
local/

# Backup files
*.bak
*.backup
*~

# Large files that shouldn't be in container
*.tar.gz
*.zip
*.rar
*.7z

# Pre-commit hooks
.pre-commit-config.yaml

# Security scanning results
scan-results/
security-reports/

# Performance test results
performance-results/
benchmarks/