# Multi-stage Enterprise Docker Build for BLNCS
# Optimized for security, performance, and production deployment

# Build stage
FROM python:3.11-slim-bullseye AS builder

# Security: Create non-root user early
RUN groupadd -r blncs && useradd -r -g blncs -u 1001 blncs

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copy requirements first for better layer caching
COPY requirements.txt requirements-prod.txt ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt -r requirements-prod.txt

# Copy source code
COPY . .

# Install application in development mode
RUN pip install --no-cache-dir -e .

# Run tests in build stage
RUN python -m pytest tests/unit/ -v

# Security scanning in build
RUN pip install bandit safety && \
    bandit -r blncs/ -f json -o /tmp/bandit-results.json && \
    safety check

# Production stage
FROM python:3.11-slim-bullseye AS production

# Security labels
LABEL maintainer="BLNCS Team <team@blncs.io>"
LABEL version="1.0.0"
LABEL description="Enterprise Bitcoin Lightning Network Control System"
LABEL security.scan-date="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Security: Install security updates and minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    tini \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Security: Create non-root user with specific UID
RUN groupadd -r blncs && useradd -r -g blncs -u 1001 -s /bin/false blncs

# Create application directories
RUN mkdir -p /app /app/data /app/logs /app/config /app/backups && \
    chown -R blncs:blncs /app

# Set work directory
WORKDIR /app

# Copy Python dependencies from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --chown=blncs:blncs . .

# Security: Set proper permissions
RUN chmod -R 755 /app && \
    chmod -R 750 /app/config && \
    chmod -R 700 /app/data /app/logs /app/backups

# Install application
RUN pip install --no-cache-dir -e .

# Health check script
COPY --chown=blncs:blncs docker/healthcheck.py /app/healthcheck.py
RUN chmod +x /app/healthcheck.py

# Security: Remove sensitive files
RUN find /app -name "*.pyc" -delete && \
    find /app -name "__pycache__" -type d -exec rm -rf {} + && \
    rm -rf /app/tests /app/.git /app/.github

# Security: Scan for secrets (basic check)
RUN ! grep -r -E "(password|secret|key|token).*=" /app/blncs/ || exit 1

# Switch to non-root user
USER blncs

# Environment variables
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    BLNCS_ENV=production \
    BLNCS_DATA_DIR=/app/data \
    BLNCS_LOG_DIR=/app/logs \
    BLNCS_CONFIG_DIR=/app/config

# Expose ports
EXPOSE 8000 8765 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python /app/healthcheck.py

# Volume for persistent data
VOLUME ["/app/data", "/app/logs", "/app/config", "/app/backups"]

# Use tini for proper signal handling
ENTRYPOINT ["/usr/bin/tini", "--"]

# Default command
CMD ["python", "-m", "blncs.main", "--config", "/app/config/blncs.yml"]

# Security: Final metadata
LABEL security.non-root="true"
LABEL security.user="blncs:1001"
LABEL security.scanned="true"

# Development stage (for local development)
FROM production AS development

USER root

# Install development dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    vim \
    git \
    htop \
    net-tools \
    && rm -rf /var/lib/apt/lists/*

# Install development Python packages
COPY requirements-dev.txt .
RUN pip install --no-cache-dir -r requirements-dev.txt

# Create development user with sudo access
RUN apt-get update && apt-get install -y sudo && \
    usermod -aG sudo blncs && \
    echo "blncs ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    rm -rf /var/lib/apt/lists/*

USER blncs

# Development environment variables
ENV BLNCS_ENV=development \
    BLNCS_DEBUG=true \
    BLNCS_LOG_LEVEL=DEBUG

# Development command
CMD ["python", "-m", "blncs.main", "--config", "/app/config/blncs-dev.yml", "--debug"]