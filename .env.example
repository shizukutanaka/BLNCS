# BLNCS Environment Variables Example
# Copy this file to .env and modify as needed
# ⚠️  DO NOT commit .env file with real secrets!

# Environment Configuration
BLNCS_ENVIRONMENT=development
BLNCS_LOG_LEVEL=info

# Data Directories
BLNCS_DATA_DIR=./data
BLNCS_CONFIG_DIR=./config
BLNCS_LOG_DIR=./logs
BLNCS_BACKUP_DIR=./backups

# Lightning Node Configuration
LND_HOST=localhost
LND_REST_PORT=8080
LND_GRPC_PORT=10009
LND_NETWORK=testnet

# Authentication (paths to certificates and macaroons)
LND_TLS_CERT_PATH=~/.lnd/tls.cert
LND_MACAROON_PATH=~/.lnd/data/chain/bitcoin/testnet/readonly.macaroon

# API Configuration
BLNCS_API_HOST=0.0.0.0
BLNCS_API_PORT=8080
BLNCS_API_KEY=your-secure-api-key-here

# Security
ENABLE_API_AUTH=false
ALLOWED_IPS=127.0.0.1,::1
RATE_LIMIT_PER_MINUTE=100

# Performance
MAX_CONNECTIONS=10
CONNECTION_TIMEOUT=30
REQUEST_TIMEOUT=60
CACHE_TTL=300

# Features
ENABLE_CACHING=true
ENABLE_HISTORY=true
ENABLE_MONITORING=true
ENABLE_AUTO_BACKUP=false
ENABLE_WEBHOOKS=false

# Webhook Configuration
WEBHOOK_URL=https://your-webhook-endpoint.com/blncs
ALERT_WEBHOOK_URL=https://your-alert-endpoint.com/blncs

# Database (if needed in future versions)
DATABASE_URL=sqlite:///./data/blncs.db

# Redis Configuration (if needed)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
PROMETHEUS_ENDPOINT=/metrics

# Development Settings
DEBUG_MODE=false
MOCK_LIGHTNING_NODE=false
ENABLE_TEST_ENDPOINTS=false

# Production Settings (override above values for production)
# BLNCS_ENVIRONMENT=production
# BLNCS_LOG_LEVEL=warning
# LND_NETWORK=mainnet
# ENABLE_API_AUTH=true
# DEBUG_MODE=false